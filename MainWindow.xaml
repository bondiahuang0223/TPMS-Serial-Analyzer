<!-- 這裡的 xmlns 宣告了標準的 WPF 命名空間 -->
<Window x:Class="WpfMaterialHello.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Initial Model" Height="450" Width="1200"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Loaded="Window_Loaded">
    <Grid>
        <!-- 1. 定義網格的欄位 -->
        <Grid.ColumnDefinitions>
            <!-- 左欄：固定寬度 350，用來放控制項 -->
            <ColumnDefinition Width="350"/>
            <!-- 右欄：寬度設為 "*" (星號)，代表填滿剩餘的所有空間 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- 1. 放在底層的 Logo 圖片 -->
        <!-- HorizontalAlignment="Right" 與 VerticalAlignment="Bottom" 把它釘在右下角 -->
        <!-- Margin="0,0,15,15" 讓它距離右邊和下面各有 15 像素的留白 -->
        <Image Source="logo.png"
               Grid.ColumnSpan="2"
               Width="80" 
               Height="80" 
               HorizontalAlignment="Right" 
               VerticalAlignment="Bottom" 
               Margin="0,0,15,15" 
               Opacity="0.3" />
        <!-- 註解必須放在標籤外面，StackPanel 負責垂直置中排列 -->
        <StackPanel Grid.Column="0" Margin="30" VerticalAlignment="Center">
            <!-- 新增：下拉式選單 (ComboBox) -->
            <ComboBox x:Name="PortComboBox"
                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                  materialDesign:HintAssist.Hint="COM Port"
                  Margin="0,0,0,20" 
                  FontSize="16"
                  ItemsSource="{Binding AvailablePorts}" 
                  SelectedItem="{Binding SelectedPort}">
            </ComboBox>

            <!-- 新增：Toggle 開關與文字標籤 (橫向排列) -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <!-- 開關左側的說明文字 -->
                <TextBlock Text="Hex Mode：" 
                       VerticalAlignment="Center" 
                       FontSize="15" 
                       Margin="0,0,10,0"/>

                <!-- Toggle 開關本身 -->
                <ToggleButton x:Name="HexModeToggle"
                          Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
            </StackPanel>
            <!-- 1. TextBox (輸入框) -->
            <TextBox x:Name="InputTextBox"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 materialDesign:HintAssist.Hint="請輸入測試文字"
                 Margin="0,0,0,30" 
                 FontSize="16"/>

            <!-- 2. 帶有圖示的 Button -->
            <Button x:Name="ActionBtn"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Click="ActionBtn_Click"
                Margin="10,-10,50,5"
                Height="25" Width="120">
                <!-- 注意：這裡我們不寫 Content="字串"，而是把內容寫在標籤裡面 -->

                <!-- 使用橫向排列的 StackPanel -->
                <StackPanel Orientation="Horizontal">

                    <!-- 內建的向量圖示，Kind 屬性決定顯示哪個圖 -->
                    <materialDesign:PackIcon Kind="SerialPort" 
                                         Width="24" Height="24" 
                                         Margin="0,0,8,0" 
                                         VerticalAlignment="Center"/>

                    <!-- 原本的文字 -->
                    <TextBlock Text="連線" 
                           VerticalAlignment="Center" 
                           FontSize="16"/>
                </StackPanel>

            </Button>



        </StackPanel>
        <materialDesign:Card Grid.Column="1" Margin="10,30,30,30" Padding="15" UniformCornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="UART 接收數據 (RX)" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Grid.Row="0"/>

                <!-- 顯示 Log 的多行文字框 -->
                <TextBox x:Name="UartLogTextBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="等待接收資料..."/>
            </Grid>
        </materialDesign:Card>


    </Grid>
</Window>