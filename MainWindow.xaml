<!-- 這裡的 xmlns 宣告了標準的 WPF 命名空間 -->
<Window x:Class="WpfMaterialHello.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Initial Model" Height="400" Width="600"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Grid>

        <!-- 1. 放在底層的 Logo 圖片 -->
        <!-- HorizontalAlignment="Right" 與 VerticalAlignment="Bottom" 把它釘在右下角 -->
        <!-- Margin="0,0,15,15" 讓它距離右邊和下面各有 15 像素的留白 -->
        <Image Source="logo.png" 
               Width="80" 
               Height="80" 
               HorizontalAlignment="Right" 
               VerticalAlignment="Bottom" 
               Margin="0,0,15,15" 
               Opacity="0.3" />
        <!-- 註解必須放在標籤外面，StackPanel 負責垂直置中排列 -->
        <StackPanel  Width="320" Margin="5,5,275,120" >
            <!-- 新增：下拉式選單 (ComboBox) -->
            <ComboBox x:Name="PortComboBox"
                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                  materialDesign:HintAssist.Hint="請選擇連線埠 (COM Port)"
                  Margin="0,0,0,20" 
                  FontSize="16">

                <!-- 在 XAML 中直接寫死幾個測試選項 (實務上通常由 C# 程式碼動態載入) -->
                <ComboBoxItem Content="COM1" />
                <ComboBoxItem Content="COM2" />
                <ComboBoxItem Content="COM3 (BLE 虛擬埠)" />
                <ComboBoxItem Content="COM4" />
            </ComboBox>

            <!-- 新增：Toggle 開關與文字標籤 (橫向排列) -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <!-- 開關左側的說明文字 -->
                <TextBlock Text="十六進位 (Hex) 發送：" 
                       VerticalAlignment="Center" 
                       FontSize="15" 
                       Margin="0,0,10,0"/>

                <!-- Toggle 開關本身 -->
                <ToggleButton x:Name="HexModeToggle"
                          Style="{StaticResource MaterialDesignSwitchToggleButton}"/>
            </StackPanel>
            <!-- 1. TextBox (輸入框) -->
            <TextBox x:Name="InputTextBox"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 materialDesign:HintAssist.Hint="請輸入測試文字"
                 Margin="0,0,0,30" 
                 FontSize="16"/>

            <!-- 2. 帶有圖示的 Button -->
            <Button x:Name="ActionBtn"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Click="ActionBtn_Click"
                Margin="20,5,20,5"
                Height="30">
                <!-- 注意：這裡我們不寫 Content="字串"，而是把內容寫在標籤裡面 -->

                <!-- 使用橫向排列的 StackPanel -->
                <StackPanel Orientation="Horizontal">

                    <!-- 內建的向量圖示，Kind 屬性決定顯示哪個圖 -->
                    <materialDesign:PackIcon Kind="BLUETOOTH" 
                                         Width="24" Height="24" 
                                         Margin="0,0,8,0" 
                                         VerticalAlignment="Center"/>

                    <!-- 原本的文字 -->
                    <TextBlock Text="點我測試" 
                           VerticalAlignment="Center" 
                           FontSize="16"/>
                </StackPanel>

            </Button>



        </StackPanel>
    </Grid>
</Window>