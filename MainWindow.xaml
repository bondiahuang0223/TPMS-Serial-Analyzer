<!-- 這裡的 xmlns 宣告了標準的 WPF 命名空間 -->
<Window x:Class="WpfMaterialHello.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="TPMS Receiver" Height="600" Width="1300"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <!-- 定義網格的欄位 -->
        <Grid.ColumnDefinitions>
            <!-- 左欄：放寬一點到 320，讓大字體卡片有呼吸空間 -->
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 背景 Logo -->
        <Image Source="logo.png" Grid.ColumnSpan="2" Width="120" Height="120" 
               HorizontalAlignment="Right" VerticalAlignment="Bottom" 
               Margin="0,0,5,8" Opacity="0.7" />

        <!-- ========================================== -->
        <!-- 左側：控制面板 + 動態卡片區 (指定在 Grid.Column="0") -->
        <!-- ========================================== -->
        <!-- 我們再用一個 Grid 把左邊切成上下兩塊 -->
        <Grid Grid.Column="0" Margin="20,30,10,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 負責放控制元件 -->
                <RowDefinition Height="*"/>
                <!-- 剩下的空間全給卡片滾動區 -->
            </Grid.RowDefinitions>

            <!-- 上半部：控制面板 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <ComboBox x:Name="PortComboBox" Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                              materialDesign:HintAssist.Hint="COM Port"
                              Width="140" Margin="0,0,20,0" FontSize="16"
                              ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"/>

                    <ComboBox x:Name="BaudRateComboBox" Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                              materialDesign:HintAssist.Hint="Baud Rate"
                              Width="110" FontSize="16"
                              ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaudRate}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="顯示時間：" VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
                    <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"  
                                           IsChecked="{Binding IsShowTime}"/>

                    <Button x:Name="ActionBtn" Style="{StaticResource MaterialDesignRaisedButton}"
                       Command="{Binding ToggleConnectionCommand}" Height="40" Margin="10,10,10,5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SerialPort" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <!-- 移除 x:Name="ActionBtnText"，改用 Text="{Binding ActionBtnText}" -->
                            <TextBlock Text="{Binding ActionBtnText}" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

 
                <!-- 分隔線 -->
                <Separator Margin="0,10,0,10"/>
            </StackPanel>

            <!-- 下半部：TPMS 動態生成的卡片區 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                
                <ItemsControl ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- 改為直向堆疊 -->
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,5,15" Padding="15" UniformCornerRadius="8">
                                <!-- 【新增】：將圖片背景套用在單張卡片內部 -->
                                <materialDesign:Card.Background>
                                    <ImageBrush ImageSource="/image/kr616.jpg" 
                                Stretch="Uniform" 
                                Opacity="0.1"
                                AlignmentX="Right" 
                                AlignmentY="Bottom"/>
                                </materialDesign:Card.Background>
                                
                                <StackPanel>
                                    <!-- 標題列：MAC 位址 + 電池低電壓告警圖示 -->
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="{Binding Mac, StringFormat='ID: {0}'}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Left"/>

                                        <!-- 當 IsLowVoltage 為 True 時才會顯示這個紅色警告 -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" 
                                                    Visibility="{Binding IsLowVoltage, Converter={StaticResource BoolToVis}}">
                                            <materialDesign:PackIcon Kind="BatteryAlert" Foreground="Red" Width="20" Height="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="電壓過低" Foreground="Red" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 大字體數值區：胎壓、溫度、里程、荷重 -->
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="胎壓" FontSize="16" VerticalAlignment="Bottom" Foreground="#3C3C3C" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding Pressure, StringFormat='{}{0} kPa'}" FontSize="30" Foreground="#007aff" HorizontalAlignment="Right" FontWeight="Bold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="溫度" FontSize="16" VerticalAlignment="Bottom" Foreground="#3C3C3C" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding Temp, StringFormat='{}{0} °C'}" FontSize="30" Foreground="#4cd964" HorizontalAlignment="Right" FontWeight="Bold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="里程" FontSize="16" VerticalAlignment="Bottom" Foreground="#3C3C3C" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding Mileage, StringFormat='{}{0} km'}" FontSize="30" Foreground="#9c27b0" HorizontalAlignment="Right" FontWeight="Bold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,15">
                                        <TextBlock Text="荷重" FontSize="16" VerticalAlignment="Bottom" Foreground="#3C3C3C" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding EstimatedLoad, StringFormat='{}{0} kg'}" FontSize="30" Foreground="#ff5722" HorizontalAlignment="Right" FontWeight="Bold"/>
                                    </Grid>

                                    <!-- 底部資訊：顯示原始的週期與印痕時間供 Debug 參考 -->
                                    <Separator Margin="0,0,0,10"/>
                                    <Grid>
                                        <TextBlock Text="{Binding Revolution, StringFormat='週期: {0} µs'}" FontSize="12" Foreground="#3C3C3C" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding Footprint, StringFormat='印痕: {0} µs'}" FontSize="12" Foreground="#3C3C3C" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Time, StringFormat='更新: {0}'}" FontSize="12" Foreground="DarkGray" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                                </StackPanel>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
        </Grid>

        <!-- ========================================== -->
        <!-- 右側：Raw Log 顯示區 (指定在 Grid.Column="1") -->
        <!-- ========================================== -->
        <materialDesign:Card Grid.Column="1" Margin="10,30,30,30" Padding="15" UniformCornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 標題與按鈕區 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="UART 接收數據 (RX)" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- 移除 Click，改為 Command -->
                        <Button x:Name="ClearLogBtn" Content="清除" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Margin="0,0,10,0" Command="{Binding ClearLogCommand}" Height="30" Padding="10,0"/>
                        <Button x:Name="SaveLogBtn" Content="儲存 Log" Style="{StaticResource MaterialDesignRaisedButton}" 
                                Command="{Binding SaveLogCommand}" Height="30" Padding="10,0"/>
                    </StackPanel>
                </Grid>

                <!-- 顯示 Log 的多行文字框 -->
                <TextBox x:Name="UartLogTextBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="等待接收資料..."/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>